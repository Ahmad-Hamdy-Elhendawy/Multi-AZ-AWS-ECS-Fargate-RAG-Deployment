{
  "family": "medical-rag-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::431451851290:role/ecs-task-execution-role",
  "containerDefinitions": [
    {
      "name": "medical-rag-container",
      "image": "public.ecr.aws/c0w4z1m9/medical-rag:latest",
      "essential": true,

      "environment": [
        {
          "name": "GROQ_MODEL",
          "value": "openai/gpt-oss-120b"
        },
        {
          "name": "HOST",
          "value": "0.0.0.0"
        },
        {
          "name": "PORT",
          "value": "8501"
        },
        {
          "name": "GROQ_API_KEY",
          "value": "${GROQ_API_KEY}"
        }
      ],

      "portMappings": [
        {
          "containerPort": 8501,
          "hostPort": 8501,
          "protocol": "tcp"
        }
      ],

      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/medical-rag",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}