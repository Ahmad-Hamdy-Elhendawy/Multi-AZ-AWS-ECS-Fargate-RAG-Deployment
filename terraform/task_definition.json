{
  "family": "medical-rag-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::431451851290:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "medical-rag-container",
      "image": "public.ecr.aws/c0w4z1m9/medical-rag:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 8501, "hostPort": 8501, "protocol": "tcp" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/medical-rag",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}